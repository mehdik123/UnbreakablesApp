# Supabase (required for production - add these in Vercel Project → Settings → Environment Variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required for coach login (no defaults — set real values in .env / Vercel; never commit them)
VITE_COACH_USERNAME=
VITE_COACH_PASSWORD=

# Optional: YouTube walkthrough shown in the client "Full guide" (watch, youtu.be, or embed URL)
# VITE_CLIENT_GUIDE_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
